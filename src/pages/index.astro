---
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource-variable/literata/opsz.css';
import '@fontsource-variable/literata/opsz-italic.css';
import '../styles/global.css';
import { profile as p, portraitExists } from '../lib/profile';

const [firstName, ...rest] = p.name.split(' ');
const lastName = rest.join(' ');
const years = (j: { start: string; end: string }) => `${j.start}–${j.end}`;
const mail = `mailto:${p.email}`;
const links = [
  { label: 'LinkedIn', href: p.links.linkedin },
  { label: 'GitHub', href: p.links.github },
  { label: 'Google Scholar', href: p.links.scholar },
].filter((l) => l.href);
const city = p.location.split(',')[0];
const since = p.experience.at(-1)?.start;
const description = `${p.name}: ${p.role.toLowerCase()} in ${p.location}. ${p.headline}`;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{p.name} · Scientist & software architect</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://zeroth.me/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#fbfaf7" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={p.name} />
    <meta property="og:description" content={p.headline} />
    <meta property="og:url" content="https://zeroth.me/" />
    {portraitExists && <meta property="og:image" content={`https://zeroth.me${p.portrait}`} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="masthead">
      <span class="masthead__name">zeroth</span>
      <span class="masthead__folio">{city} · {new Date().getFullYear()}</span>
      <a class="masthead__mail textlink" href={mail}>{p.email}</a>
    </header>

    <main id="main">
      <!-- Opening spread: the portrait poses, the name answers. -->
      <section class="spread spread--open" aria-labelledby="name">
        <figure class="plate">
          {portraitExists ? (
            <img
              src={p.portrait}
              alt={p.portrait_alt}
              width="768"
              height="804"
              decoding="async"
              fetchpriority="high"
            />
          ) : (
            <div class="plate__pending"><span>Portrait pending: add {p.portrait}</span></div>
          )}
          <figcaption>{p.name}, {city}.</figcaption>
        </figure>

        <span class="seam" aria-hidden="true"></span>

        <div class="page page--answer">
          <h1 id="name" class="name">
            <span class="name__first">{firstName}</span>
            {lastName && <span class="name__last">{lastName}</span>}
          </h1>
          <p class="standfirst">{p.role}</p>
          <p class="deck">{p.headline}</p>
          <p class="intro">{p.intro}</p>
          <p class="actions">
            <a class="btn" href={mail}>
              Write to {firstName}
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5.5 15.5 10 11 14.5" /></svg>
            </a>
            {links.map((l) => <a class="textlink" href={l.href} rel="me">{l.label}</a>)}
          </p>
        </div>
      </section>

      <!-- Focus spread -->
      <section class="spread spread--text wrap" aria-labelledby="focus-title">
        <div class="page page--pose">
          <h2 id="focus-title" class="spread__title">What I <em>work</em> on</h2>
          {p.stack.length > 0 && (
            <dl class="stack">
              {p.stack.map((g) => (
                <div class="stack__row">
                  <dt>{g.area}</dt>
                  <dd>{g.tools.map((t, k) => <><span class="nowrap">{t}</span>{k < g.tools.length - 1 && ' · '}</>)}</dd>
                </div>
              ))}
            </dl>
          )}
        </div>
        <span class="seam" aria-hidden="true"></span>
        <div class="page">
          <ul class="focus" role="list">
            {p.focus.map((f) => (
              <li>
                <h3 class="focus__title">{f.title}</h3>
                <p>{f.text}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- The roles: one spread each, mirrored left and right -->
      <section class="roles" aria-labelledby="roles-title">
        <div class="roles__head wrap">
          <h2 id="roles-title" class="spread__title">Since {since}, <em>{p.experience.length} roles.</em></h2>
          <p class="roles__intro">Newest first. Each role is set beside the result it's remembered for. Open any role to read the full record.</p>
        </div>

        {p.experience.map((j, i) => (
          <article class="feature wrap" data-side={i % 2 === 0 ? 'left' : 'right'} aria-labelledby={`role-${i}`}>
            <div class="feature__result">
              <p class="result">{j.specimen}</p>
              {j.specimen_note && <p class="result__note">{j.specimen_note}</p>}
            </div>
            <span class="seam" aria-hidden="true"></span>
            <div class="feature__byline">
              <h3 id={`role-${i}`} class="feature__org">{j.org}</h3>
              <p class="feature__role">{j.role}</p>
              <p class="feature__years">{years(j)}{j.place && <> · {j.place}</>}</p>
              {j.org_note && <p class="feature__note">{j.org_note}</p>}
              {j.points.length > 0 && (
                <details class="record">
                  <summary>
                    <span class="record__open">Read the full record</span>
                    <span class="record__close">Close the record</span>
                    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3v10M3 8h10" /></svg>
                  </summary>
                  <ul role="list">
                    {j.points.map((pt) => <li>{pt}</li>)}
                  </ul>
                </details>
              )}
            </div>
          </article>
        ))}
      </section>

      <!-- Training spread, set like a contents page -->
      <section class="spread spread--text wrap" aria-labelledby="training-title">
        <div class="page page--pose">
          <h2 id="training-title" class="spread__title"><em>Training</em></h2>
          <p class="caption-line">
            <span class="caption-line__label">Languages</span>
            {p.languages.map((l, k) => <><span class="nowrap">{l.name} ({l.level.toLowerCase()})</span>{k < p.languages.length - 1 && ', '}</>)}
          </p>
        </div>
        <span class="seam" aria-hidden="true"></span>
        <div class="page">
          <ul class="contents" role="list">
            {p.education.map((e) => (
              <li>
                <span class="contents__main"><strong>{e.degree}</strong> <span class="contents__sub">{e.school}</span></span>
                <span class="contents__year">{e.year}</span>
              </li>
            ))}
            {p.certifications.map((c) => (
              <li>
                <span class="contents__main">{c}</span>
                <span class="contents__year">Cert.</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- Closing spread: the open invitation -->
      <section class="spread spread--close wrap" id="contact" aria-labelledby="close-title">
        <div class="page page--pose">
          <h2 id="close-title" class="close__title">{p.open_slot.title}</h2>
        </div>
        <span class="seam" aria-hidden="true"></span>
        <div class="page">
          <p class="close__text">{p.open_slot.text}</p>
          <p class="actions">
            <a class="btn" href={mail}>
              {p.email}
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5.5 15.5 10 11 14.5" /></svg>
            </a>
          </p>
        </div>
      </section>
    </main>

    <footer class="colophon wrap">
      <p class="colophon__name">{p.name}</p>
      <p class="colophon__place">{p.location}</p>
      <nav class="colophon__links" aria-label="Contact">
        <a class="textlink" href={mail}>{p.email}</a>
        {links.map((l) => <a class="textlink" href={l.href} rel="me">{l.label}</a>)}
      </nav>
      <p class="colophon__copy">© {new Date().getFullYear()} {p.name}</p>
    </footer>
  </body>
</html>
